# Backend selection: "mock" (localStorage, zero setup) or "convex" (real backend)
VITE_BACKEND=mock

# Required when VITE_BACKEND=convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# The following live on the Convex deployment (set with `npx convex env set`),
# not in this file:
#   JWT_PRIVATE_KEY  — PKCS#8 PEM, signs session JWTs
#   JWKS             — matching public JWK set, served at /.well-known/jwks.json
#   RESEND_API_KEY   — optional; enables email delivery of sign-in codes
